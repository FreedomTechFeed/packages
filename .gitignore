# Release-tooling self-tests run the scripts in .github/workflows/scripts/*.py
# in place, which drops a __pycache__/ beside them. Never publish bytecode to a
# release tag: 2026-10-15 (t1) shipped one inside a release-naming commit.
__pycache__/
*.pyc
