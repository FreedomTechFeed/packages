#!/bin/sh
# TollGate admin board setup: create/repair the dedicated uhttpd instance and
# make sure rpcd (which serves the `tollgate` ubus object) is running.
#
# The admin SPA is served at the ROOT of :8090 over HTTP from its brand webroot
# (/www/tollgate, or /www/net4sats for net4sats builds); when /etc/uhttpd.crt
# and /etc/uhttpd.key exist, an opt-in HTTPS listener is also added on :8443
# (one uhttpd instance cannot do HTTP+HTTPS on the same port). LuCI stays on
# uhttpd.main (:8080; webroot /www) and the captive portal on uhttpd.portal
# (:2051); neither is touched here, and the admin instance never exposes LuCI's
# /www.
#
# Idempotent and self-healing: every run re-asserts the listeners, webroot and
# LuCI-proofing, so it also repairs the older home=/www scheme and a stale
# HTTPS-only :8090 left behind by an earlier experiment.

ADMIN_HOME=
for candidate in /www/tollgate /www/net4sats; do
    if [ -d "$candidate" ]; then
        ADMIN_HOME="$candidate"
        break
    fi
done
[ -n "$ADMIN_HOME" ] || ADMIN_HOME=/www/tollgate

uci -q get uhttpd.admin >/dev/null 2>&1 || echo "Creating uhttpd admin instance on :8090 (home ${ADMIN_HOME})"
uci set uhttpd.admin=uhttpd

# Serve the board over plain HTTP on :8090 — the URL people type
# (http://<router>:8090/) and the same scheme as LuCI on :8080. A single uhttpd
# instance cannot serve HTTP and HTTPS on the same port (bind: Address already
# in use), so HTTPS is offered OPT-IN on a separate port (:8443) when a
# cert/key pair exists. Never advertise a TLS listener without a cert: uhttpd
# would fail to start it.
uci -q delete uhttpd.admin.listen_http
uci -q delete uhttpd.admin.listen_https
uci add_list uhttpd.admin.listen_http='0.0.0.0:8090'
uci add_list uhttpd.admin.listen_http='[::]:8090'
uci -q delete uhttpd.admin.cert
uci -q delete uhttpd.admin.key
if [ -f /etc/uhttpd.crt ] && [ -f /etc/uhttpd.key ]; then
    uci add_list uhttpd.admin.listen_https='0.0.0.0:8443'
    uci add_list uhttpd.admin.listen_https='[::]:8443'
    uci set uhttpd.admin.cert='/etc/uhttpd.crt'
    uci set uhttpd.admin.key='/etc/uhttpd.key'
fi
uci set uhttpd.admin.ubus_prefix='/ubus'
uci set uhttpd.admin.script_timeout='60'
uci set uhttpd.admin.network_timeout='30'
uci set uhttpd.admin.max_requests='3'
uci set uhttpd.admin.tcp_keepalive='1'
uci set uhttpd.admin.no_dirlists='1'
uci set uhttpd.admin.home="$ADMIN_HOME"
uci set uhttpd.admin.error_page='/index.html'
# Never let the admin port resolve LuCI's CGI: without home=/www there is no
# LuCI webroot under the board home, but drop the prefixes so a stray
# /cgi-bin/luci can only ever 404.
uci -q delete uhttpd.admin.cgi_prefix
uci -q delete uhttpd.admin.lua_prefix

# :8090 (and the admin TLS port :8443) belong to the admin instance alone
for sec in $(uci show uhttpd 2>/dev/null | sed -n 's/^uhttpd\.\([^.]*\)=uhttpd$/\1/p'); do
    [ "$sec" = admin ] && continue
    uci -q del_list "uhttpd.$sec.listen_http=0.0.0.0:8090"
    uci -q del_list "uhttpd.$sec.listen_http=[::]:8090"
    uci -q del_list "uhttpd.$sec.listen_https=0.0.0.0:8090"
    uci -q del_list "uhttpd.$sec.listen_https=[::]:8090"
    uci -q del_list "uhttpd.$sec.listen_https=0.0.0.0:8443"
    uci -q del_list "uhttpd.$sec.listen_https=[::]:8443"
done
uci commit uhttpd

# Resolve .apk-new files left by apk when existing files were modified.
find "$ADMIN_HOME" -name '*.apk-new' \
    -exec sh -c 'mv "$1" "${1%.apk-new}"' _ {} \; 2>/dev/null

/etc/init.d/rpcd restart
/etc/init.d/uhttpd restart

exit 0
